# Copy to .env.local for development. In production set these in the host's dashboard
# (Netlify: Site configuration > Environment variables; Hostinger: the Node.js app's
# Environment variables, or .env on a VPS). Never commit real keys.

# Production URL, used for canonical links, sitemap and structured data. Read at build time.
NEXT_PUBLIC_SITE_URL=https://makeoveroverseas.com

# Contact form email delivery. Without credentials for the chosen provider, dev logs the
# inquiry to the server console; production shows an error with a WhatsApp fallback.
#   resend (default): RESEND_API_KEY + CONTACT_FROM_EMAIL on a domain verified in Resend.
#   gmail (temporary, until domain email exists): GMAIL_USER + GMAIL_APP_PASSWORD.
EMAIL_PROVIDER=resend

# Gmail: a 16-character App Password (Google Account > Security > 2-Step Verification >
# App passwords), not the normal password. Mail is sent from GMAIL_USER, and to it too
# unless CONTACT_TO_EMAIL is set.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Resend (https://resend.com)
RESEND_API_KEY=
# Where inquiries are delivered.
CONTACT_TO_EMAIL=
# Resend only; must be on a domain verified in Resend, e.g. "Makeover Overseas <website@makeoveroverseas.com>".
CONTACT_FROM_EMAIL=
