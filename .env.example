# Copy to .env.local and fill in. Never commit real keys.

# Production URL, used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://seductive.ae

# Contact form email delivery (https://resend.com). Without a key, dev logs the inquiry
# to the server console; production shows an error with a WhatsApp fallback.
RESEND_API_KEY=
# Where inquiries are delivered.
CONTACT_TO_EMAIL=admin@seductive.ae
# Must be on a domain verified in Resend, e.g. "Seductive Website <website@seductive.ae>".
CONTACT_FROM_EMAIL=
