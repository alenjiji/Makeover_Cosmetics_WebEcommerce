
NEXT_PUBLIC_SITE_URL=https://makeoveroverseas.com

# Contact and order forms are delivered by Netlify Forms (no keys needed): see
# src/lib/forms.ts and public/__forms.html, then set up Netlify > Forms > notifications.

# Shopify. With domain + token set, the cart becomes a Shopify cart with prices and
# Shopify checkout; without them the site runs in quote mode. See docs/SHOPIFY.md.
SHOPIFY_STORE_DOMAIN=            # e.g. makeover-overseas.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN= # public Storefront API token from the Headless channel
SHOPIFY_COUNTRY=IN               # market whose prices/currency the site shows (INR)
SHOPIFY_WEBHOOK_SECRET=          # signing key from Settings > Notifications > Webhooks
SHOPIFY_ACCOUNT_URL=             # optional; defaults to https://<store domain>/account
SHOPIFY_API_VERSION=2026-10
.